MONGODB_URI=mongodb://localhost:27017/invorra?replicaSet=rs0&directConnection=true
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Optional. When empty, the assistant explains with deterministic templates grounded in tool results.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# baseline uses the in-process weighted moving average. python calls ML_SERVICE_URL and falls back.
FORECAST_PROVIDER=python
ML_SERVICE_URL=http://localhost:8000
# Leave empty to log domain events locally instead of publishing to JetStream.
NATS_URL=
