generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  products        Product[]
  warehouses      Warehouse[]
  inventory       Inventory[]
  sales           Sale[]
  suppliers       Supplier[]
  forecasts       Forecast[]
  recommendations ReplenishmentRecommendation[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  auditLogs          AuditLog[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(VIEWER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs              AuditLog[]
  recordedSales          Sale[]
  createdPurchaseOrders  PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  approvedPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderApprovedBy")

  @@index([organizationId])
}

model Product {
  id             String        @id @default(cuid())
  organizationId String
  sku            String
  name           String
  category       String?
  brand          String?
  unit           String        @default("pcs")
  unitCost       Decimal       @db.Decimal(12, 2)
  sellingPrice   Decimal       @db.Decimal(12, 2)
  status         ProductStatus @default(ACTIVE)
  leadTimeDays   Int           @default(5)
  reorderPoint   Int           @default(0)
  safetyStock    Int           @default(0)
  moq            Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization    Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventory       Inventory[]
  sales           Sale[]
  forecasts       Forecast[]
  recommendations ReplenishmentRecommendation[]
  poItems         PurchaseOrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  city           String
  state          String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventory       Inventory[]
  sales           Sale[]
  forecasts       Forecast[]
  recommendations ReplenishmentRecommendation[]
  purchaseOrders  PurchaseOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([city])
}

model Inventory {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  warehouseId    String
  quantity       Int      @default(0)
  reservedQty    Int      @default(0)
  reorderPoint   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([organizationId, productId, warehouseId])
}

model Sale {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  warehouseId    String
  recordedById   String?
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(14, 2)
  channel        String   @default("quick-commerce")
  soldAt         DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([soldAt])
  @@index([organizationId, soldAt])
  @@index([organizationId, productId, warehouseId, soldAt])
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  email          String?
  phone          String?
  city           String?
  leadTimeDays   Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  recommendations ReplenishmentRecommendation[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Forecast {
  id              String   @id @default(cuid())
  organizationId  String
  productId       String
  warehouseId     String
  forecastDate    DateTime
  predictedDemand Decimal  @db.Decimal(12, 2)
  lowerBound      Decimal? @db.Decimal(12, 2)
  upperBound      Decimal? @db.Decimal(12, 2)
  confidence      Decimal  @default(0) @db.Decimal(5, 4)
  modelVersion    String   @default("weighted-ma-v1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId, warehouseId, forecastDate, modelVersion])
  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([forecastDate])
  @@index([organizationId, forecastDate])
}

model ReplenishmentRecommendation {
  id              String               @id @default(cuid())
  organizationId  String
  productId       String
  warehouseId     String
  supplierId      String?
  recommendedQty  Int
  currentStock    Int
  averageDailyDemand Decimal           @db.Decimal(12, 4)
  daysOfInventory Decimal?             @db.Decimal(12, 2)
  forecastDemand  Decimal              @default(0) @db.Decimal(12, 2)
  safetyStock     Int                  @default(0)
  leadTimeDays    Int                  @default(0)
  moq             Int                  @default(1)
  stockoutProbability Decimal          @default(0) @db.Decimal(6, 4)
  rawOrderQuantity Int                 @default(0)
  planningHorizonDays Int              @default(14)
  riskLevel       RiskLevel
  status          RecommendationStatus @default(PENDING)
  rationale       String?
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?

  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([status])
  @@index([organizationId, status])
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  organizationId   String
  supplierId       String
  warehouseId      String
  recommendationId String?             @unique
  poNumber         String
  status           PurchaseOrderStatus @default(DRAFT)
  notes            String?
  orderedAt        DateTime?
  expectedAt       DateTime?
  createdById      String?
  approvedById     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse      Warehouse                    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  recommendation ReplenishmentRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  createdBy      User?                        @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?                        @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items          PurchaseOrderItem[]

  @@unique([organizationId, poNumber])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@index([supplierId])
  @@index([warehouseId])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  organizationId  String
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Decimal  @db.Decimal(12, 2)
  receivedQty     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, productId])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([productId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}
